# Vorlage für die Variablen der Azure-Anleitungen.
# Kopieren nach ~/azure.env (NICHT ins Projekt), ausfüllen, mit "chmod 600 ~/azure.env" schützen und in jedem Terminal laden:  source ~/azure.env
# Gilt für zsh (Mac) und bash. Platzhalter 'HIER-EINTRAGEN' müssen ersetzt werden.

# --- Namen: Ressourcen, die schon existieren, mit dem echten Namen; neue Ressourcen: Namen selbst festlegen ---
RG='HIER-EINTRAGEN'                 # Ressourcengruppe der Anwendung        (az group list --output table)
LOC='HIER-EINTRAGEN'                # Region, z. B. germanywestcentral; bei privater Variante die Region des Netzes
SUFFIX='HIER-EINTRAGEN'             # kurz, nur Kleinbuchstaben/Ziffern, z. B. pco1; macht globale Namen eindeutig
ACR="acrservicecheck${SUFFIX}"      # nur Kleinbuchstaben und Ziffern
PG="pg-servicecheck-${SUFFIX}"
SA="stservicecheck${SUFFIX}"        # 3-24 Zeichen, nur Kleinbuchstaben und Ziffern
PLAN='plan-servicecheck'
PLAN_SKU='P0V3'                     # Stufe des App-Service-Plans; bei Kontingentfehler S1 oder P1V3 versuchen
APP="app-servicecheck-${SUFFIX}"    # Adresse: https://$APP.azurewebsites.net
DBNAME='servicecheck'
PGADMIN='scadmin'

# --- nur private Variante (docs/azure-deployment-private.md) ---
RG_NET='HIER-EINTRAGEN'             # Ressourcengruppe des virtuellen Netzes (az network vnet list --output table)
VNET='HIER-EINTRAGEN'               # Name des virtuellen Netzes
SNET_DB='snet-db'
SNET_APP='snet-app'
SNET_PE='snet-pe'
ZONE_PG='servicecheck.private.postgres.database.azure.com'
ZONE_BLOB='privatelink.blob.core.windows.net'
ZONE_APP='privatelink.azurewebsites.net'
VM_SIZE='Standard_B2ts_v2'          # Test-VM (Schritt P8); Bv1 (Standard_B1s) ist End of Life. Größen: az vm list-sizes --location $LOC

# --- Geheimnisse: EINMAL erzeugen, hier eintragen und im Passwort-Manager ablegen ---
# Erzeugen:  openssl rand -hex 16   (PGPASS)   und   openssl rand -hex 32   (SECRET_KEY)
PGPASS='HIER-EINTRAGEN'
SECRET_KEY='HIER-EINTRAGEN'
ADMIN_PASSWORD='HIER-EINTRAGEN'     # mindestens 10 Zeichen, nicht "admin"

# --- Prüfung: nennt jede Variable, die leer ist oder noch den Platzhalter enthält ---
for v in RG LOC SUFFIX ACR PG SA PLAN PLAN_SKU APP DBNAME PGADMIN PGPASS SECRET_KEY ADMIN_PASSWORD; do
  eval "val=\${$v}"
  if [ -z "$val" ] || [ "$val" = "HIER-EINTRAGEN" ]; then echo "FEHLT: $v"; fi
done
# Nur private Variante zusätzlich prüfen:
for v in RG_NET VNET SNET_DB SNET_APP SNET_PE VM_SIZE; do
  eval "val=\${$v}"
  if [ -z "$val" ] || [ "$val" = "HIER-EINTRAGEN" ]; then echo "FEHLT (private Variante): $v"; fi
done
echo "Prüfung beendet"
